{
  "manifest_version": 3,
  "name": "ChatRecall AI - AI Conversation Finder",
  "version": "1.0.0",
  "description": "Instantly find and recall past conversations across ChatGPT, Claude, and Perplexity by subject and open them in separate tabs.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://www.perplexity.ai/*",
    "*://*.perplexity.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ChatRecall AI - Search Past Conversations"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://www.perplexity.ai/*",
        "*://*.perplexity.ai/*"
      ],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
